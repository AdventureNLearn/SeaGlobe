{
  "$comment": "StarFire dated snapshot records. Credit: StarFire by @wntrslmbr. Coordinates at most 0.1 degree. Historical only; no live feed.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "title",
    "example",
    "place",
    "geo",
    "date",
    "time",
    "agency",
    "finding",
    "claim",
    "citations",
    "license_basis",
    "location_basis",
    "coordinate_source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^starfire:[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{4}$"
    },
    "kind": {
      "const": "starfire-record"
    },
    "title": { "type": "string" },
    "place": { "type": "string" },
    "geo": { "type": ["object", "null"] },
    "location_basis": { "type": "string" },
    "coordinate_source": { "type": "string" },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
    },
    "time": {
      "type": "object",
      "required": ["start", "end", "precision"]
    },
    "agency": { "type": "string" },
    "finding": { "type": "string" },
    "claim": {
      "enum": ["we-have-a-record", "not-proven", "people-disagree"]
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "license_basis": { "type": "string" },
    "example": { "type": "boolean" }
  }
}
